<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기 버튼"
        android:layout_margin="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="송금하기"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingLeft="26dp"
        android:layout_marginTop="50dp"
        android:paddingBottom="60dp"
        android:textStyle="bold"
        android:textSize="20sp"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/bankaccountButton"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="계좌 송금하기"
        android:background="@drawable/button_default"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:textSize="16sp"
        android:textColor="#000000" />

    <Button
        android:id="@+id/kakaopayButton"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="카카오페이로 결제하기"
        android:background="@drawable/button_default"
        app:layout_constraintTop_toBottomOf="@id/bankaccountButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:textSize="16sp"
        android:textColor="#000000" />

    <Button
        android:id="@+id/tossButton"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="토스로 결제하기"
        android:background="@drawable/button_default"
        app:layout_constraintTop_toBottomOf="@id/kakaopayButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:textSize="16sp"
        android:textColor="#000000" />

    <Button
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="다음으로"
        android:background="@drawable/button_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.85"
        android:textColor="#000000" /> <!-- 초기 비활성화 상태로 설정 -->
</androidx.constraintlayout.widget.ConstraintLayout>
