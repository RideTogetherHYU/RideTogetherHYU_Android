<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="start">


    <!-- 사용자 메시지: 오른쪽 정렬 -->
    <LinearLayout
        android:id="@+id/senderMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/senderMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/message_bubble_sender"
            android:padding="8dp"
            android:textColor="#ffffff"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 상대방 메시지: 왼쪽 정렬 -->
    <LinearLayout
        android:id="@+id/receiverMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:padding="8dp">

        <!-- 프로필 이미지 -->
        <ImageView
            android:id="@+id/receiverProfileImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_profile"
            android:layout_marginEnd="8dp"
            android:contentDescription="Profile Image" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/receiverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:textColor="#777"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/receiverMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/message_bubble"
                android:padding="8dp"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
